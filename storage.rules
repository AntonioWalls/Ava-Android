rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function image() {
      return request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /profile_images/{uid}/avatar.jpg {
      allow read: if request.auth != null;
      allow create, update: if owns(uid) && image();
      allow delete: if owns(uid);
    }
    match /post_media/{uid}/{postId}/image.jpg {
      allow read: if request.auth != null;
      allow create: if owns(uid) && image();
      allow delete: if owns(uid);
    }
  }
}
